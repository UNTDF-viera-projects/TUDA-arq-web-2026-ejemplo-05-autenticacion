# Compose funciona sin crear .env. Si cambiás un puerto, ajustá también URL y origen.
BACKEND_PORT=8003
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8003
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SECRET_KEY=demo-only-change-in-production
# El cliente controlado recibe BASIC_EMAIL y BASIC_PASSWORD de configuración privada.
# No definir la contraseña como VITE_* ni versionar el archivo .env.
